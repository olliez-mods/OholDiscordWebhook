msg_id: ''
servers:
- bigserver2.onehouronelife.com
- friends.onehouronelife.com
- oneday.onehouronelife.com
- server1.onehouronelife.com
- server2.onehouronelife.com
webhook: 

trim_domain: no
domain_to_trim: .onehouronelife.com

show_port: yes

use_bs2_bot: no
bs2_bot_token: token_here

# Server probes are shared between every copy of this script on the machine, so they
# only happen once per cycle instead of once per copy. All copies must run as the same
# user and point at the same cache_path
cache: no
cache_path: ~/.cache/ohol-live-status/status.json
cache_ttl: 45          # Keep under the run interval so each cycle still refreshes
cache_lock_timeout: 10 # Probe alone rather than wait longer than this
